# Environment variables for the PipelineAI guardrail backend

# GitHub personal access token used to fetch PR files and post commit statuses.
# Needs 'repo:status' and 'public_repo' (or 'repo' for private repos) scopes.
GITHUB_TOKEN=your_personal_access_token

# Shared secret configured on the GitHub webhook. Required in production —
# without it, incoming webhooks are NOT signature-verified (dev convenience only).
WEBHOOK_SECRET=your_webhook_secret

# Optional. Enables real AI-generated remediation suggestions via an OpenAI-compatible
# API, grounded in the issues the static analysis agents already detected. Without this,
# the guardrail still fully functions (ALLOW/BLOCK verdicts are always deterministic
# static analysis) but suggestions fall back to the issue's own recommendation text.
OPENAI_API_KEY=

# Optional. Point the remediation client at any OpenAI-compatible endpoint. Leave both
# unset for OpenAI itself. Example for Gemini's OpenAI-compatible API:
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-2.0-flash
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Optional. Defaults shown.
AGENT_TIMEOUT_SECONDS=10
PORT=8000

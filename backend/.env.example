# Environment variables for the PipelineAI guardrail backend.
# Copy to backend/.env for local dev. On Render, set these in the service's
# Environment tab (never commit real values).

# --- GitHub API token (server-side secret; NOT user login) ---------------------
# Used to (a) fetch PR files/diffs and (b) POST ALLOW/BLOCK commit statuses.
#   - unset            -> public-repo diffs still fetch (60 req/hr, unauthenticated);
#                         commit statuses CANNOT be posted (logged only).
#   - fine-grained/PAT -> needs "Commit statuses: read and write" (classic: repo:status;
#                         plus repo read for private repos).
GITHUB_TOKEN=

# --- Webhook signature secret -------------------------------------------------
# The same value you enter in the GitHub webhook "Secret" field.
#   - set   -> every POST /webhook must carry a valid X-Hub-Signature-256 (HMAC
#              SHA-256); bad/missing signature -> 401. REQUIRED for any public URL.
#   - unset -> DEMO MODE: signatures are not checked, a startup WARNING is logged,
#              and GET /health reports "webhook_signature_enforced": false.
WEBHOOK_SECRET=

# --- Optional: AI remediation text on BLOCK verdicts --------------------------
# The ALLOW/BLOCK decision is always deterministic and never depends on this.
# Unset -> BLOCK suggestions fall back to the static analyzer's own recommendation.
OPENAI_API_KEY=
# Point the client at any OpenAI-compatible endpoint (leave blank for OpenAI).
# Gemini example:
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-2.5-flash
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# --- Optional tuning ---------------------------------------------------------
# Seconds before an in-flight analysis is abandoned and an error status posted.
AGENT_TIMEOUT_SECONDS=10

# Comma-separated browser origins allowed to call this API cross-origin (only
# needed if you put a static status page in front of it). Never "*". Unset = none.
ALLOWED_ORIGINS=

# Local dev only. On Render, PORT is injected automatically — do NOT set it.
PORT=8000
